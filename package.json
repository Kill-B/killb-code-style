{
  "name": "@killb/code-style",
  "version": "0.0.0-development",
  "description": "KillB's shared ESLint and Prettier configuration",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kill-B/killb-code-style.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "prettier.mjs",
    "eslint/*.mjs"
  ],
  "exports": {
    "./prettier": "./prettier.mjs",
    "./eslint": "./eslint/index.mjs",
    "./eslint/next": "./eslint/next.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.mjs",
    "semantic-release": "semantic-release"
  },
  "prettier": "./prettier.mjs",
  "release": {
    "branches": [
      "main"
    ]
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "@eslint/js": "^9.39.0 || ^10.0.0",
    "eslint": "^9.39.0 || ^10.0.0",
    "eslint-config-next": ">=16.0.0",
    "prettier": "^3.9.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "next": "16.4.5",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
